    "strecken": {
      "nuerburgring": {"name": "Nürburgring", "land": "Deutschland", "typ": "strecke", "lat": 50.334, "lon": 6.943, "quelle": "f1-circuits (MIT)", "loc": ["Nürburgring"], "slug": "nuerburgring", "am": "am Nürburgring", "ort": "Nürburg · Eifel · Rheinland-Pfalz", "adresse": {"ort": "Nürburg", "region": "Rheinland-Pfalz", "land": "DE"}, "eroeffnet": 1927, "web": "https://nuerburgring.de/", "fakten": [{"k": "Nordschleife", "v": "20,8 km"}], "portrait": "Der Nürburgring in der Eifel wurde 1927 eröffnet. Die Nordschleife ist rund 20,8 Kilometer lang, Jackie Stewart gab ihr den Spitznamen „Grüne Hölle“. Seit 1984 gibt es zusätzlich die Grand-Prix-Strecke.", "quellen": {"eroeffnet": ["https://www.nuerburgring.de/history?locale=en", "https://de.wikipedia.org/wiki/N%C3%BCrburgring"], "nordschleife": ["https://de.wikipedia.org/wiki/N%C3%BCrburgring", "https://en.wikipedia.org/wiki/N%C3%BCrburgring"], "gruene_hoelle": ["https://de.wikipedia.org/wiki/N%C3%BCrburgring", "https://en.wikipedia.org/wiki/N%C3%BCrburgring"], "gp_strecke_1984": ["https://de.wikipedia.org/wiki/N%C3%BCrburgring", "https://en.wikipedia.org/wiki/N%C3%BCrburgring"], "ort": ["https://de.wikipedia.org/wiki/N%C3%BCrburgring", "https://www.gt-world-challenge-europe.com/event/252/n%C3%BCrburgring"], "adresse": ["https://www.gt-world-challenge-europe.com/event/252/n%C3%BCrburgring", "https://de.wikipedia.org/wiki/N%C3%BCrburgring"], "web": ["https://nuerburgring.de/", "https://www.gt-world-challenge-europe.com/event/252/n%C3%BCrburgring"]}},
      "hockenheim": {"name": "Hockenheimring", "land": "Deutschland", "typ": "strecke", "lat": 49.33, "lon": 8.572, "quelle": "f1-circuits (MIT)", "loc": ["Hockenheimring"], "slug": "hockenheimring", "am": "am Hockenheimring", "ort": "Hockenheim · Baden-Württemberg", "adresse": {"ort": "Hockenheim", "region": "Baden-Württemberg", "land": "DE"}, "eroeffnet": 1932, "portrait": "Der Hockenheimring entstand 1932 als rund zwölf Kilometer langer Dreieckskurs, der auch Mercedes als Teststrecke diente. Beim Umbau 2002 wurde die Strecke deutlich verkürzt, die schnellen Passagen durch den Wald entfielen.", "quellen": {"ort": ["https://www.dtm.com/de/events/hockenheim-finale-2025", "https://de.wikipedia.org/wiki/Hockenheimring_Baden-W%C3%BCrttemberg"], "adresse": ["https://www.dtm.com/de/events/hockenheim-finale-2025", "https://de.wikipedia.org/wiki/Hockenheimring_Baden-W%C3%BCrttemberg"], "eroeffnet": ["https://www.formula1.com/en/racing/2019/germany", "https://de.wikipedia.org/wiki/Hockenheimring_Baden-W%C3%BCrttemberg"], "dreieckskurs_1932": ["https://www.formula1.com/en/racing/2019/germany", "https://de.wikipedia.org/wiki/Hockenheimring_Baden-W%C3%BCrttemberg"], "umbau_2002": ["https://www.formula1.com/en/racing/2019/germany", "https://de.wikipedia.org/wiki/Hockenheimring_Baden-W%C3%BCrttemberg"]}},
