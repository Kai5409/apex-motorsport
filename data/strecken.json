      "norisring": {"name": "Norisring", "land": "Deutschland", "typ": "strecke", "lat": 49.43139, "lon": 11.125, "quelle": "Wikipedia", "loc": ["Nürnberg"], "slug": "norisring", "am": "am Norisring", "ort": "Zeppelinfeld · Nürnberg", "adresse": {"ort": "Nürnberg", "land": "DE"}, "eroeffnet": 1947, "portrait": "Der Norisring ist ein Stadtkurs in Nürnberg rund um die Steintribüne am Zeppelinfeld. Am 18. Mai 1947 fand dort das erste Motorradrennen statt, ab 1948 folgten Autorennen. Die heutige Streckenführung besteht seit 1972.", "quellen": {"ort": ["https://www.dtm.com/de/events/norisring-2023", "https://de.wikipedia.org/wiki/Norisring"], "adresse": ["https://www.dtm.com/de/events/norisring-2023", "https://de.wikipedia.org/wiki/Norisring"], "eroeffnet": ["https://www.dtm.com/de/events/norisring-2023", "https://de.wikipedia.org/wiki/Norisring"], "stadtkurs_steintribuene": ["https://www.dtm.com/de/events/norisring-2023", "https://de.wikipedia.org/wiki/Norisring"], "erstes_rennen_1947": ["https://www.dtm.com/de/events/norisring-2023", "https://de.wikipedia.org/wiki/Norisring"], "streckenfuehrung_1972": ["https://www.dtm.com/de/events/norisring-2023", "https://de.wikipedia.org/wiki/Norisring", "https://en.wikipedia.org/wiki/Norisring"]}},
      "berlin": {"name": "Berlin-Tempelhof", "land": "Deutschland", "typ": "stadt", "lat": 52.4733, "lon": 13.4014, "quelle": "Wikipedia", "loc": ["Berlin"], "slug": "berlin-tempelhof", "am": "in Berlin-Tempelhof", "ort": "Flughafen Tempelhof · Berlin", "adresse": {"ort": "Berlin", "region": "Berlin", "land": "DE"}, "portrait": "Die Formel E fährt in Berlin auf einem temporären Kurs auf dem Gelände des ehemaligen Flughafens Tempelhof. Berlin steht seit der ersten Saison 2014/15 im Kalender, nur 2015/16 wurde auf einem Stadtkurs nahe dem Alexanderplatz gefahren.", "quellen": {"ort": ["https://www.fiaformulae.com/en/news/races/season-13-calendar-where-will-formula-e-be-racing-in-202627", "https://en.wikipedia.org/wiki/Tempelhof_Airport_Street_Circuit"], "adresse": ["https://www.fiaformulae.com/en/news/races/season-13-calendar-where-will-formula-e-be-racing-in-202627", "https://en.wikipedia.org/wiki/Tempelhof_Airport_Street_Circuit"], "flughafen_tempelhof": ["https://fiaformulae.com/en/news/1062386/track-map-what-does-the-berlin-e-prix-circuit-look-like-", "https://en.wikipedia.org/wiki/Tempelhof_Airport_Street_Circuit"], "kalender_seit_2014_15": ["https://www.fia.com/news/berlin-set-host-record-breaking-twelfth-e-prix-iconic-tempelhof-circuit", "https://fiaformulae.com/en/news/1062386/track-map-what-does-the-berlin-e-prix-circuit-look-like-", "https://en.wikipedia.org/wiki/Berlin_ePrix"]}},
